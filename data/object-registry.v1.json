  "validationRules": {
    "selectorUniqueness": "A selector should not be assigned to multiple active exclusive objects unless a room-gated runtime card explicitly owns the exception.",
    "ownershipCheck": "Before binding events, check id, selector, owner, role, action, exclusive, runtimeStatus, versionStatus, and changePolicy.",
    "protectedChainCheck": "If protected:true, do not modify without staged plan and rollback.",
    "coordinateRule": "Current coordinates should use base-image coordinates, not device-specific CSS nudges.",
    "roomGateRule": "Hotspots that belong to different rooms must be gated by active room element, e.g. gameRoom.active vs home.active, so they do not leak across scenes.",
    "overlayRule": "Decorative overlays are not hotspots, but they still need identity, owner, and base-image coordinate records when they align with room art.",
    "versionRule": "canonicalCurrent is mutable only through explicit versioned change, not silent replacement.",
    "directorRule": "Use directorRef and directorTags here; put long director scripts and sample lines in docs/DIRECTOR_GUIDE.md."
  },
  "shortIncidentExample": {
    "type": "selectorReuse",
    "lesson": "A notebook entry once reused the game console selector and took over the game menu. The long-term rule is not a blacklist; it is selector ownership plus exclusive:true. A later room-leak incident showed active room gating is also required for shared/global selectors."
  }
