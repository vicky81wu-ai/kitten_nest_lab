  "validationRules": {
    "selectorUniqueness": "A selector should not be assigned to multiple active exclusive objects unless a room-gated runtime card explicitly owns the exception.",
    "ownershipCheck": "Before binding events, check id, selector, owner, role, action, exclusive, runtimeStatus, versionStatus, and changePolicy.",
    "protectedChainCheck": "If protected:true, do not modify without staged plan and rollback.",
    "coordinateRule": "Current coordinates should use base-image coordinates, not device-specific CSS nudges.",
    "roomGateRule": "Hotspots that belong to different rooms must be gated by active room element, e.g. gameRoom.active vs home.active, so they do not leak across scenes.",
    "notebookDraftRule": "hubbyNote current preview and editor draft are separate. Do not auto-fill the editor from current page on render. Saving archives the saved/confirmed text immediately if not already present, instead of delaying it until the next save.",
    "panelClassificationRule": "A panel injected globally into /cloud is not automatically shared. Classify by actual scene ownership and actual entry points. The current powder notebook panel is home-scoped because only home opens it.",
    "overlayRule": "Decorative overlays are not hotspots, but they still need identity, owner, and base-image coordinate records when they align with room art.",
    "versionRule": "canonicalCurrent is mutable only through explicit versioned change, not silent replacement.",
    "directorRule": "Use directorRef and directorTags here; put long director scripts and sample lines in docs/DIRECTOR_GUIDE.md."
  },
  "shortIncidentExample": {
    "type": "selectorReuseAndMisclassification",
    "lesson": "A notebook entry once reused the game console selector and took over the game menu. A later room-leak incident showed active room gating is required for cross-scene selectors. A notebook duplication incident showed current-page preview and editor draft must stay separate. A classification correction showed that the powder notebook hotspot and panel are currently home-scoped; coffeeCorner has no physical powder notebook, and the panel is not shared unless another scene explicitly opens it. The lap-close variant adds its own selector-owned hotspots and bubble so it does not inherit normal coffeeCorner bubble behavior."
  }
