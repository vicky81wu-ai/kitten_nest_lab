{
  "schemaVersion": "nest-manifest.v2",
  "version": "0.1.1",
  "status": "isolated-preview",
  "promoted": false,
  "route": "/v2/index.html",
  "rules": {
    "singleSource": "This manifest is the only v2 runtime identity, ownership, scene, action, coordinate, panel, text-port, and effect source.",
    "noIdentityNoBinding": true,
    "childIsolation": true,
    "baseImageCoordinatesOnly": true,
    "stateWritesAllowed": false,
    "stableRouteUntouched": "/cloud"
  },
  "runtime": {
    "entryScene": "home",
    "mountOrder": [
      "state",
      "asset",
      "layout",
      "panel",
      "hotspot",
      "textPort",
      "effect",
      "sceneRuntime"
    ],
    "readyOrder": [
      "state",
      "asset",
      "layout",
      "panel",
      "hotspot",
      "textPort",
      "effect",
      "sceneRuntime"
    ],
    "reconcileOrder": [
      "panel",
      "hotspot",
      "textPort",
      "effect",
      "layout"
    ],
    "supportedActionTypes": [
      "scene.go",
      "scene.push",
      "scene.back",
      "scene.jumpTo",
      "scene.dock",
      "text.toggleNext",
      "text.hide",
      "panel.open",
      "panel.close"
    ],
    "state": {
      "endpoint": "/api/state",
      "fallbackUrl": "/v2/data/preview-state.v2.json",
      "timeoutMs": 4500,
      "refreshOn": ["pageshow", "focus", "visibilitychange"]
    },
    "textTargetRegistryUrl": "/data/text-targets.v1.json"
  },
  "controllers": {
    "state": {
      "className": "StateController",
      "owns": ["state-read", "state-cache", "state-refresh"],
      "lifecycle": ["mount", "ready", "reconcile", "suspend", "destroy"]
    },
    "asset": {
      "className": "AssetController",
      "owns": ["asset-key-resolution", "preload", "decode", "fallback"],
      "lifecycle": ["mount", "ready", "reconcile", "suspend", "destroy"]
    },
    "sceneRuntime": {
      "className": "SceneRuntimeController",
      "owns": ["go", "push", "back", "jumpTo", "scene-stack", "atomic-scene-transition"],
      "lifecycle": ["mount", "ready", "reconcile", "suspend", "destroy"]
    },
    "layout": {
      "className": "LayoutController",
      "owns": ["cover-box", "base-image-projection", "placement-readiness"],
      "lifecycle": ["mount", "ready", "reconcile", "suspend", "destroy"]
    },
    "hotspot": {
      "className": "HotspotController",
      "owns": ["hotspot-render", "single-pointer-delegation", "action-dispatch"],
      "lifecycle": ["mount", "ready", "reconcile", "suspend", "destroy"]
    },
    "textPort": {
      "className": "TextPortController",
      "owns": ["text-render", "queue-index", "show", "hide", "show-next"],
      "lifecycle": ["mount", "ready", "reconcile", "suspend", "destroy"]
    },
    "panel": {
      "className": "PanelController",
      "owns": ["panel-open", "panel-close", "panel-layer", "scene-exit-cleanup"],
      "lifecycle": ["mount", "ready", "reconcile", "suspend", "destroy"]
    },
    "effect": {
      "className": "EffectController",
      "owns": ["sparkles", "steam", "clock-hands", "effect-pause", "effect-destroy"],
      "lifecycle": ["mount", "ready", "reconcile", "suspend", "destroy"]
    }
  },
  "assets": {
    "home.auto": {
      "strategy": "timeOfDay",
      "dayAsset": "home.day",
      "nightAsset": "home.night",
      "dayStartsAt": 7,
      "nightStartsAt": 18
    },
    "home.day": {
      "sources": [
        {
          "url": "https://pmkxzmogolxllijzqnfr.supabase.co/storage/v1/object/public/nest-public-assets/assets/rooms/home/day.jpg",
          "role": "supabaseCanonical"
        },
        { "url": "/assets/rooms/home/day.jpg", "role": "staticFallback" }
      ]
    },
    "home.night": {
      "sources": [
        {
          "url": "https://pmkxzmogolxllijzqnfr.supabase.co/storage/v1/object/public/nest-public-assets/assets/rooms/home/night.jpg",
          "role": "supabaseCanonical"
        },
        { "url": "/assets/rooms/home/night.jpg", "role": "staticFallback" }
      ]
    },
    "coffeeCorner.main": {
      "sources": [
        {
          "url": "https://pmkxzmogolxllijzqnfr.supabase.co/storage/v1/object/public/nest-public-assets/assets/rooms/coffee-corner/morning-evening.jpg",
          "role": "supabaseCanonical"
        },
        { "url": "/assets/rooms/coffee-corner/morning-evening.jpg", "role": "staticFallback" }
      ]
    },
    "coffeeCorner.lapClose": {
      "sources": [
        {
          "url": "https://pmkxzmogolxllijzqnfr.supabase.co/storage/v1/object/public/nest-public-assets/assets/rooms/coffee-corner/variants/lap-close-01.jpg?v=20260613-lap-close-1",
          "role": "supabaseCanonical"
        }
      ],
      "failurePolicy": "showExplicitAssetError"
    }
  },
  "globalObjects": [
    "system.dockLeft",
    "system.dockRight",
    "system.inspectorHot",
    "system.inspectorPanel"
  ],
  "scenes": {
    "home": {
      "id": "home",
      "parent": null,
      "assetKey": "home.auto",
      "objects": [
        "home.clockHands",
        "home.sparkles",
        "home.hubbyNoteHot",
        "home.hubbyNotePanel"
      ],
      "docks": {
        "left": null,
        "right": { "type": "scene.go", "target": "coffeeCorner" }
      }
    },
    "coffeeCorner": {
      "id": "coffeeCorner",
      "parent": null,
      "assetKey": "coffeeCorner.main",
      "objects": [
        "coffeeCorner.bubble",
        "coffeeCorner.tattoo19_8",
        "coffeeCorner.lapEnterHot",
        "coffeeCorner.photoWallHot",
        "coffeeCorner.gameConsoleHot",
        "coffeeCorner.steam",
        "memories.panel",
        "gameMenu.panel"
      ],
      "docks": {
        "left": { "type": "scene.go", "target": "home" },
        "right": null
      }
    },
    "lapClose": {
      "id": "lapClose",
      "parent": "coffeeCorner",
      "assetKey": "coffeeCorner.lapClose",
      "objects": [
        "lapClose.bubble",
        "lapClose.bubbleTrigger"
      ],
      "docks": {
        "left": { "type": "scene.back" },
        "right": null
      },
      "blocksParentInteractive": true
    }
  },
  "objects": {
    "system.dockLeft": {
      "id": "system.dockLeft",
      "kind": "hotspot",
      "ownerScene": "*",
      "controller": "hotspot",
      "selector": "#v2-dock-left",
      "mount": "existing",
      "action": { "type": "scene.dock", "side": "left" },
      "exclusive": true,
      "runtimeStatus": "active",
      "versionStatus": "canonicalV2Preview"
    },
    "system.dockRight": {
      "id": "system.dockRight",
      "kind": "hotspot",
      "ownerScene": "*",
      "controller": "hotspot",
      "selector": "#v2-dock-right",
      "mount": "existing",
      "action": { "type": "scene.dock", "side": "right" },
      "exclusive": true,
      "runtimeStatus": "active",
      "versionStatus": "canonicalV2Preview"
    },
    "system.inspectorHot": {
      "id": "system.inspectorHot",
