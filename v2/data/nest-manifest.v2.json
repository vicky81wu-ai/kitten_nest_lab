{
  "schemaVersion": "nest-manifest.v2",
  "version": "0.5.0",
  "status": "production",
  "promoted": true,
  "route": "/cloud",
  "rules": {
    "singleSource": "This manifest is the only v2 runtime identity, ownership, scene, action, coordinate, panel, text-port, and effect source.",
    "noIdentityNoBinding": true,
    "childIsolation": true,
    "baseImageCoordinatesOnly": true,
    "stateWritesAllowed": {
      "mode": "registeredTargetOnly",
      "targetIds": ["hubbyNote"]
    },
    "productionRoute": "/cloud"
  },
  "runtime": {
    "entryScene": "home",
    "mountOrder": [
      "state",
      "asset",
      "layout",
      "panel",
      "hotspot",
      "textPort",
      "effect",
      "sceneRuntime"
    ],
    "readyOrder": [
      "state",
      "asset",
      "layout",
      "panel",
      "hotspot",
      "textPort",
      "effect",
      "sceneRuntime"
    ],
    "backgroundReadyControllers": ["state"],
    "reconcileOrder": [
      "panel",
      "hotspot",
      "textPort",
      "effect",
      "layout"
    ],
    "supportedActionTypes": [
      "scene.go",
      "scene.push",
      "scene.back",
      "scene.jumpTo",
      "route.open",
      "asset.toggle",
      "text.toggleNext",
      "text.hide",
      "dialogue.next",
      "panel.open",
      "panel.close"
    ],
    "state": {
      "endpoint": "/api/state",
      "fallbackUrl": "/v2/data/preview-state.v2.json",
      "timeoutMs": 4500,
      "refreshOn": ["pageshow", "focus", "visibilitychange"]
    },
    "stateWrites": {
      "endpoint": "/api/set-state",
      "authHeader": "X-Nest-Token",
      "tokenStorageKeys": ["kittenNestToken", "nestToken"]
    },
    "textTargetRegistryUrl": "/data/text-targets.v1.json"
  },
  "controllers": {
    "state": {
      "className": "StateController",
      "owns": ["state-read", "state-cache", "state-refresh"],
      "lifecycle": ["mount", "ready", "reconcile", "suspend", "destroy"]
    },
    "asset": {
      "className": "AssetController",
      "owns": ["asset-key-resolution", "preload", "decode", "fallback"],
      "lifecycle": ["mount", "ready", "reconcile", "suspend", "destroy"]
    },
    "sceneRuntime": {
      "className": "SceneRuntimeController",
      "owns": ["go", "push", "back", "jumpTo", "scene-stack", "atomic-scene-transition"],
      "lifecycle": ["mount", "ready", "reconcile", "suspend", "destroy"]
    },
    "layout": {
      "className": "LayoutController",
      "owns": ["cover-box", "base-image-projection", "placement-readiness"],
      "lifecycle": ["mount", "ready", "reconcile", "suspend", "destroy"]
    },
    "hotspot": {
      "className": "HotspotController",
      "owns": ["hotspot-render", "single-pointer-delegation", "action-dispatch"],
      "lifecycle": ["mount", "ready", "reconcile", "suspend", "destroy"]
    },
    "textPort": {
      "className": "TextPortController",
      "owns": ["text-render", "queue-index", "show", "hide", "show-next", "dialogue-turn-index", "dialogue-speaker-switch"],
      "lifecycle": ["mount", "ready", "reconcile", "suspend", "destroy"]
    },
    "panel": {
      "className": "PanelController",
      "owns": ["panel-open", "panel-close", "panel-layer", "scene-exit-cleanup"],
      "lifecycle": ["mount", "ready", "reconcile", "suspend", "destroy"]
    },
    "effect": {
      "className": "EffectController",
      "owns": ["sparkles", "jar-sparkles", "steam", "clock-hands", "effect-pause", "effect-destroy"],
      "lifecycle": ["mount", "ready", "reconcile", "suspend", "destroy"]
    }
  },
  "assets": {
    "home.auto": {
      "strategy": "timeOfDay",
